# Kopiera till .env och fyll i. Generera nycklar enligt README.
DATABASE_PATH=./dev.db
APP_ENCRYPTION_KEY=            # 32 byte base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_TTL_DAYS=180
CALDAV_SERVER=https://caldav.icloud.com
CALDAV_CALENDAR_NAME=Gemensamt-test
VAPID_PUBLIC_KEY=              # npx web-push generate-vapid-keys
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:du@example.com
PUBLIC_APP_NAME=Planeraren
TZ_DEFAULT=Europe/Stockholm
SYNC_INTERVAL_MINUTES=5
