    },
    "Du kan också dela en receptsida från Safari till HouseMates." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can also share a recipe page from Safari to HouseMates."
          }
        }
      }
    },
    "Du är ensam i hushållet, så hushållet med listor och middagar raderas. Sedan kan du skapa ett nytt hushåll eller gå med i ett annat." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You're the only one in the household, so the household and its lists and dinners will be deleted. Then you can create a new household or join another one."
          }
        }
      }
    },
